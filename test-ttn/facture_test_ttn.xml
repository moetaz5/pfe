        </Nad>
        <RffSection>
          <Reference refID="1234567ABC"/>
        </RffSection>
        <CtaSection>
          <Contact functionCode="IC">
            <ContactIdentifier>1</ContactIdentifier>
            <ContactName>Support Médica-Sign</ContactName>
          </Contact>
          <Communication>
            <ComMeansType>EM</ComMeansType>
            <ComAdress>support@medicasign.tn</ComAdress>
          </Communication>
        </CtaSection>
      </PartnerDetails>
      
      <!-- Acheteur / Destinataire (Client - Clinique Carthage) -->
      <PartnerDetails functionCode="BY">
        <Nad>
          <PartnerIdentifier type="V">9876543XYZ</PartnerIdentifier>
          <PartnerName nameType="A">Clinique de Carthage S.A.</PartnerName>
