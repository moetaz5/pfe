      controlingAgency="TTN" 
      version="1.0">
  
  <!-- En-tête de la Facture Électronique Tunisienne (TEIF Header) -->
  <InvoiceHeader>
    <!-- Identifiant fiscal de l'émetteur (Votre Matricule Fiscal de Test) -->
    <MessageSenderIdentifier type="V">1234567ABC</MessageSenderIdentifier>
    <!-- Identifiant fiscal du destinataire/client -->
    <MessageRecieverIdentifier type="V">9876543XYZ</MessageRecieverIdentifier>
  </InvoiceHeader>
  
  <!-- Corps de la Facture Électronique (TEIF Body) -->
  <InvoiceBody>
    <!-- Informations Générales de la Facture -->
    <Bgm>
      <!-- Numéro de facture unique -->
      <DocumentIdentifier>FAC-2026-0042</DocumentIdentifier>
      <!-- Type de document (380 = Facture commerciale) -->
      <DocumentType code="380"/>
    </Bgm>
    
    <!-- Dates (Dtm Section) -->
    <Dtm>
      <!-- Date d'émission de la facture -->
      <DateText format="CCYYMMDD" functionCode="137">20260518</DateText>
      <!-- Date de prestation / livraison -->
      <DateText format="CCYYMMDD" functionCode="138">20260518</DateText>
      <!-- Date d'exigibilité du paiement -->
      <DateText format="CCYYMMDD" functionCode="140">20260518</DateText>
    </Dtm>
    
    <!-- Sections des Partenaires (Fournisseur & Client) -->
    <PartnerSection>
      <!-- Fournisseur (Émetteur - Médica-Sign) -->
      <PartnerDetails functionCode="SU">
        <Nad>
          <PartnerIdentifier type="V">1234567ABC</PartnerIdentifier>
          <PartnerName nameType="A">Société Médica-Sign S.A.</PartnerName>
          <PartnerAdresses lang="fr">
            <AdressDescription>Avenue Habib Bourguiba</AdressDescription>
