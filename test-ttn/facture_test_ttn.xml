      </PartnerDetails>
    </PartnerSection>
    
    <!-- Section de Paiement (RIB & Conditions) -->
    <PytSection>
      <PytSectionDetails>
        <Pyt>
          <PaymentTearmsTypeCode>10</PaymentTearmsTypeCode>
          <PaymentTearmsDescription>Paiement à réception</PaymentTearmsDescription>
